import numpy as np

def create_star(name, mass, radius, temperature):
    return{'name': name, 'mass': mass, 'radius': radius, 'temperature': temperature}

def print_star(star):
    print(f'The name of the star is {star['name']}, and its mass is about {star['mass']} sunmasses, /nit has a radius of {star['radius']}, and a temperature of {star['temperature']} Kelvin')

def is_FGKM(star, t_limit):
    return star['temperature'] < t_limit

